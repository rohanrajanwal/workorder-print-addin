{
  "manifest_version": 3,
  "name": "Geotab Work Order Print",
  "version": "1.0",
  "description": "Adds a Print button to MyGeotab work order detail pages",
  "content_scripts": [
    {
      "matches": ["https://my.geotab.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["printWorkOrder.js", "injector.js"],
      "matches": ["https://my.geotab.com/*"]
    }
  ]
}
